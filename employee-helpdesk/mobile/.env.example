# Mobile .env example — copy to .env and fill in values
# After changing .env, restart Expo with: npx expo start -c

# Backend API URL — for local dev leave blank, it auto-detects
# For production deployment, set this to your hosted backend:
# EXPO_PUBLIC_API_URL=https://your-deployed-backend.com/api
EXPO_PUBLIC_API_URL=https://employee-ticket-backendend.onrender.com/api
